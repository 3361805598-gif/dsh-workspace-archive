{
  "name": "@local/dsh-workspace-archive",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Archive workspace conversations and hide fully archived workspaces from the sidebar, with restoration and workspace pinning.",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
